{
  "compilerOptions": {
    "outDir": "dist",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "target": "es2017",
    "lib": [
      "es2017"
    ],
    "typeRoots": [
      "node_modules/@types"
    ],
    "inlineSources": true,
    "inlineSourceMap": true,
    "sourceRoot": "src/"
  },
  "include": [
    "*.js",
    "src/**/*.ts",
    "tests/**/*.spec.ts"
  ]
}
